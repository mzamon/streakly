<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Streakly.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_user_circle"
                app:srTitle="@string/personal_details" />

            <View style="@style/Streakly.Divider" />

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_lock"
                app:srTitle="@string/account_security" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_bell"
                app:srTitle="@string/notifications" />

            <View style="@style/Streakly.Divider" />

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowPreferences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_sliders"
                app:srTitle="@string/preferences" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_refresh"
                app:srTitle="@string/offline_sync" />

            <View style="@style/Streakly.Divider" />

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_download"
                app:srTitle="@string/data_backup" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_info"
                app:srTitle="@string/about_help" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_logout"
                app:srTitle="@string/logout"
                app:srDanger="true"
                app:srChevron="false" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
