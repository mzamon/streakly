<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/sand_050">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/create_account"
            android:textSize="28sp" android:textColor="@color/text_primary"
            android:fontFamily="serif" android:layout_marginTop="32dp" />

        <EditText android:id="@+id/etName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/name_hint" android:layout_marginTop="24dp" />

        <EditText android:id="@+id/etEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/email_hint" android:inputType="textEmailAddress"
            android:layout_marginTop="12dp" />

        <EditText android:id="@+id/etPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/password_hint" android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <ProgressBar android:id="@+id/pwStrength"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:max="3" android:progress="0" android:layout_marginTop="8dp" />

        <CheckBox android:id="@+id/cbTerms"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/i_agree" android:layout_marginTop="16dp" />

        <TextView android:id="@+id/tvError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/error" android:textSize="13sp"
            android:layout_marginTop="8dp" android:visibility="gone" />

        <Button android:id="@+id/btnRegister"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/register"
            android:background="@drawable/bg_button_flame"
            android:textColor="@color/text_on_flame" android:textAllCaps="false" />

        <TextView android:id="@+id/tvGoLogin"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/have_account" android:textColor="@color/streakly_teal"
            android:layout_marginTop="20dp" android:padding="8dp" />
    </LinearLayout>
</ScrollView>