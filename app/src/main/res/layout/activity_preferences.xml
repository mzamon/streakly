<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Streakly.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/preferences" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_moon"
                app:srTitle="@string/theme" />

            <View style="@style/Streakly.Divider" />

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_globe"
                app:srTitle="@string/language" />

            <View style="@style/Streakly.Divider" />

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowWeekStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_calendar"
                app:srTitle="@string/week_start" />

            <View style="@style/Streakly.Divider" />

            <com.streakly.app.ui.widget.SettingRow
                android:id="@+id/rowTimeFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srIcon="@drawable/ic_clock"
                app:srTitle="@string/time_format" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
