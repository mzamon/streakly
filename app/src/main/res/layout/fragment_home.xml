<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_primary">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_streak_header"
        android:padding="20dp" android:layout_margin="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/current_streak" android:textColor="#B8D9E0"
            android:textSize="12sp" android:letterSpacing="0.1" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="4dp">
            <TextView android:id="@+id/tvStreak"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="48sp" android:textColor="@color/sand_050"
                android:fontFamily="serif" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" days" android:textColor="#B8D9E0" android:textSize="16sp"
                android:layout_marginBottom="10dp" android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:id="@+id/tvLevel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Lv. 1" android:textColor="@color/flame_500"
                android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" · " android:textColor="@color/flame_500" android:textSize="14sp" />
            <TextView android:id="@+id/tvPoints"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 pts" android:textColor="@color/flame_500" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/today" android:textColor="@color/text_primary"
        android:textSize="16sp" android:textStyle="bold"
        android:paddingHorizontal="20dp" android:paddingTop="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHabits"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingTop="8dp" />

    <LinearLayout android:id="@+id/layoutEmpty"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical"
        android:gravity="center" android:visibility="gone">
        <ImageView android:layout_width="72dp" android:layout_height="72dp"
            android:src="@drawable/ic_flame_logo" android:alpha="0.4" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/no_habits" android:textSize="20sp"
            android:fontFamily="serif" android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/no_habits_msg" android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <Button android:id="@+id/btnAddHabit"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:text="@string/add_habit"
        android:background="@drawable/bg_button_flame"
        android:textColor="@color/text_on_flame" android:textAllCaps="false" />
</LinearLayout>