<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography -->
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="Text.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Text.Number" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Streakly.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/orange_light</item>
    </style>
    <style name="Widget.Streakly.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Streakly.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/orange</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Streakly.Button.Danger" parent="Widget.Streakly.Button.Outline">
        <item name="android:textColor">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.Streakly.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/card_elevated</item>
        <item name="hintTextColor">@color/orange</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="errorTextColor">@color/danger</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="errorIconTint">@color/danger</item>
        <item name="endIconTint">@color/text_muted</item>
        <item name="startIconTint">@color/text_muted</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.Streakly.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/bg_alt</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Streakly.NavIndicator</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.Streakly.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/transparent</item>
    </style>

    <!-- Chips used for icon / colour / day pickers -->
    <style name="Widget.Streakly.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.Streakly.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextAppearance">@style/Text.Section</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="titleCentered">false</item>
    </style>

    <style name="Streakly.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/stroke</item>
    </style>
</resources>
