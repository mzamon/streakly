<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Streakly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/card_elevated</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="colorOnSecondary">@color/navy_800</item>
        <item name="colorSecondaryContainer">@color/card_elevated</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/stroke</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg_alt</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="bottomNavigationStyle">@style/Widget.Streakly.BottomNav</item>
        <item name="materialButtonStyle">@style/Widget.Streakly.Button</item>
        <item name="textInputStyle">@style/Widget.Streakly.TextInput</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Streakly.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Streakly.Dialog</item>
    </style>

    <style name="Theme.Streakly" parent="Base.Theme.Streakly" />

    <!-- Splash / welcome / onboarding always use the dark brand artwork -->
    <style name="Theme.Streakly.Splash" parent="Theme.Streakly">
        <item name="android:windowBackground">@color/navy_800</item>
        <item name="android:statusBarColor">@color/navy_800</item>
        <item name="android:navigationBarColor">@color/navy_800</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.Streakly.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Streakly.BottomSheet</item>
    </style>

    <style name="Widget.Streakly.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Streakly.Sheet</item>
    </style>

    <style name="ShapeAppearance.Streakly.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.Streakly.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Streakly.Dialog</item>
    </style>

    <style name="ShapeAppearance.Streakly.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
